{
  "name": "deepwise",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DeepWise — a fully self-hosted code agent with custom models, tools, skills and MCP. Desktop (Electron) + Mobile (React Native), fully synced.",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "pnpm --filter @deepwise/desktop dev",
    "dev:mobile": "pnpm --filter @deepwise/mobile start",
    "build": "pnpm --filter @deepwise/core build && pnpm --filter @deepwise/desktop build",
    "build:core": "pnpm --filter @deepwise/core build",
    "package": "pnpm build && pnpm --filter @deepwise/desktop package",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "knip": "knip",
    "test": "pnpm -r --no-bail test",
    "test:unit": "pnpm -r --no-bail test",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "prepare": "lefthook install",
    "test:e2e": "pnpm --filter @deepwise/desktop test:e2e"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "knip": "^6.32.2",
    "lefthook": "^2.1.10",
    "oxlint": "^1.78.0",
    "typescript": "5.9.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kittors/deepwise.git"
  }
}
