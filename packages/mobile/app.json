{
  "expo": {
    "name": "Lyra",
    "slug": "lyra",
    "version": "0.9.6",
    "orientation": "portrait",
    "scheme": "lyra",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#171717",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#171717"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.lyra.app",
      "buildNumber": "4",
      "infoPlist": {
        "UIUserInterfaceStyle": "Automatic",
        "NSCameraUsageDescription": "允许 Lyra 访问相机以拍摄照片或扫描配对二维码。",
        "NSPhotoLibraryUsageDescription": "允许 Lyra 访问相册以选择要发送给 Agent 的图片。",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "dev.lyra.app",
      "versionCode": 4,
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "usesCleartextTraffic": true,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "CAMERA"
      ],
      "splash": {
        "image": "./assets/logo.png",
        "resizeMode": "contain",
        "backgroundColor": "#171717"
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E8F3FF"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#171717",
          "dark": {
            "image": "./assets/logo.png",
            "resizeMode": "contain",
            "backgroundColor": "#171717"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "允许 Lyra 访问相机以拍摄照片或扫描配对二维码。"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "允许 Lyra 访问相册以选择要发送给 Agent 的图片。",
          "cameraPermission": "允许 Lyra 访问相机以拍摄照片或扫描配对二维码。"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "splitPerAbi": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
